{
  "name": "gnosis-bridge",
  "version": "3.0.17",
  "scripts": {
    "app:dev": "pnpm --filter gnosis-bridge-explorer dev",
    "app:build": "pnpm --filter gnosis-bridge-explorer build",
    "app:start": "pnpm --filter gnosis-bridge-explorer start",
    "app:lint": "pnpm --filter gnosis-bridge-explorer lint",
    "app:lint:fix": "pnpm --filter gnosis-bridge-explorer lint:fix",
    "indexer:dev": "pnpm --filter envio-indexer dev",
    "indexer:build": "pnpm --filter envio-indexer build",
    "indexer:codegen": "pnpm --filter envio-indexer codegen",
    "indexer:start": "pnpm --filter envio-indexer start",
    "indexer:stop": "pnpm --filter envio-indexer stop",
    "audit": "pnpm audit --audit-level=high"
  },
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "app",
      "alerts",
      "subgraph",
      "envio-indexer",
      "envio-indexer/generated"
    ]
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@safe-global/safe-apps-sdk": "9",
        "react-reconciler > react": "18"
      }
    },
    "overrides": {
      "crypto-es": "2.1.0",
      "elliptic": "6.6.1",
      "ws": "8.21.0",
      "shell-quote": "1.10.0",
      "form-data@3": "3.0.5",
      "form-data@4": "4.0.6",
      "serialize-javascript": "7.0.3",
      "body-parser": "1.20.3",
      "path-to-regexp": "0.1.13",
      "defu": "6.1.7",
      "lodash": "4.18.1",
      "picomatch": "4.0.4",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "axios@>=1.15.2 <1.18.0": "1.18.0",
      "sharp": "0.35.3"
    }
  }
}