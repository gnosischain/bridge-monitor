{
  "name": "gnosis-bridge",
  "version": "3.0.17",
  "scripts": {
    "app:dev": "pnpm --filter gnosis-bridge-explorer dev",
    "app:build": "pnpm --filter gnosis-bridge-explorer build",
    "app:start": "pnpm --filter gnosis-bridge-explorer start",
    "app:lint": "pnpm --filter gnosis-bridge-explorer lint",
    "app:lint:fix": "pnpm --filter gnosis-bridge-explorer lint:fix",
    "indexer:dev": "pnpm --filter envio-indexer dev",
    "indexer:build": "pnpm --filter envio-indexer build",
    "indexer:codegen": "pnpm --filter envio-indexer codegen",
    "indexer:start": "pnpm --filter envio-indexer start"
  },
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "app",
      "alerts",
      "subgraph",
      "envio-indexer",
      "envio-indexer/generated"
    ]
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "overrides": {
      "crypto-es": "2.1.0",
      "elliptic": "6.6.1",
      "ws": "8.18.0",
      "serialize-javascript": "7.0.3",
      "body-parser": "1.20.3",
      "path-to-regexp": "0.1.12",
      "picomatch": "4.0.4"
    }
  }
}