# =============================================================================
# Env var naming convention
#
#   NEXT_PUBLIC_*   Build-time and PUBLIC. Inlined into the client bundle at
#                   build time (passed as Docker build-args in CI) and readable
#                   by anyone in the browser.
#
#   (no prefix)     Runtime and SERVER-SIDE only.
#                   Secret provisioned by DevOps (never baked into the image,
#                   never set by CI). For local dev, put them in .env.local.
# =============================================================================

# Application Name
NEXT_PUBLIC_APP_NAME=GnosisBridgeMonitor
# Default theme: dark | light
NEXT_PUBLIC_DEFAULT_THEME=dark
# Default chain
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# Show cookies warning
NEXT_PUBLIC_COOKIES_WARNING_ENABLED=true
# Google Analytics Id
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Transaction Polling (10 sec)
NEXT_PUBLIC_POLLING_INTERVAL=10000

# RPCs (server-only — NOT NEXT_PUBLIC). The browser talks to the same-origin
# /api/rpc proxy, which reads these at request time, so the upstream URLs (the
# mainnet one is a Tenderly gateway with an embedded access key) never ship in the
# client bundle. RPC_MAINNET is required (no public fallback); RPC_GNOSIS is
# optional — the proxy falls back to https://rpc.gnosischain.com/ when it is unset.
RPC_MAINNET=
RPC_GNOSIS=

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_DAPP_URL="https://bridge.gnosischain.com/"
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

NEXT_PUBLIC_ALCHEMY_API_KEY=

# Runtime server-side secrets (see convention at top); set locally in .env.local.
ENVIO_INDEXER_URL=
ENVIO_INDEXER_TOKEN=

NEXT_PUBLIC_INDEXER_BACKEND=envio

# Build metadata — injected by CI on non-production deploys (develop) only.
# When set, the footer shows "<env> · <shortSHA>" linked to the GitHub commit.
# Leave empty locally; the footer badge is hidden when NEXT_PUBLIC_COMMIT_SHA is unset.
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_APP_ENV=
