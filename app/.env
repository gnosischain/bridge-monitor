# Application Name
NEXT_PUBLIC_APP_NAME=GnosisBridgeMonitor
# Default theme: dark | light
NEXT_PUBLIC_DEFAULT_THEME=dark
# Default chain
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# Show cookies warning
NEXT_PUBLIC_COOKIES_WARNING_ENABLED=true
# Google Analytics Id
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Transaction Polling (10 sec)
NEXT_PUBLIC_POLLING_INTERVAL=10000

# RPCs
NEXT_PUBLIC_RPC_MAINNET=https://rpc.ankr.com/eth
NEXT_PUBLIC_RPC_GNOSIS=https://rpc.gnosischain.com
NEXT_PUBLIC_RPC_CHIADO=https://rpc.chiadochain.net

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_DAPP_URL=https://bridge-explorer.staging.gnosisdev.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=6c59ccb44865af2a70b6e2c97a891eb6

# The Graph
NEXT_PUBLIC_SUBGRAPH_ORGANIZATION=nicosampler
NEXT_PUBLIC_SUBGRAPH_SUFFIX=